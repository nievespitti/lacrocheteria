# ====================================================
# SUPABASE — autenticación y "Mis proyectos"
# ====================================================
# 1. Ve a https://supabase.com, crea (o abre) el proyecto
# 2. Copia la URL y la anon key desde Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ====================================================
# ANTHROPIC — generación de patrones con IA (api/patron.js)
# ====================================================
# Clave de API de Claude (console.anthropic.com). Solo se usa en servidor,
# nunca se expone al cliente (por eso no lleva prefijo VITE_).
ANTHROPIC_API_KEY=tu_api_key_aqui

# ====================================================
# FORMULARIO DE CONTACTO — Web3Forms
# ====================================================
# La access key de Web3Forms está hardcodeada en src/pages/Contacto.jsx
# (no requiere variable de entorno). Si se rota la key, actualizar ahí.
